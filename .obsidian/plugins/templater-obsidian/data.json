    {
      "folder": "01-Daily/weekly",
      "template": "_meta/templates/weekly.md"
    },
    {
      "folder": "01-Daily/monthly",
      "template": "_meta/templates/monthly.md"
    },
    {
      "folder": "10-Areas/health/metrics",
      "template": "_meta/templates/health-metrics.md"
    },
    {
      "folder": "10-Areas/finance/monthly",
      "template": "_meta/templates/finance-monthly.md"
    }
